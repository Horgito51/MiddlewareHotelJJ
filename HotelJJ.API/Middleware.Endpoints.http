@Middleware_HostAddress = https://localhost:7104
@jwt = REEMPLAZAR_JWT
@reservaGuid = 00000000-0000-0000-0000-000000000000
@estadiaGuid = 00000000-0000-0000-0000-000000000000
@facturaGuid = 00000000-0000-0000-0000-000000000000

### Health
GET {{Middleware_HostAddress}}/health

### Auth login
POST {{Middleware_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "demo@hoteljj.com",
  "password": "Demo123*"
}

### Auth register-cliente
POST {{Middleware_HostAddress}}/api/v1/auth/register-cliente
Content-Type: application/json

{
  "username": "cliente.demo@hoteljj.com",
  "password": "Demo123*"
}

### Auth refresh
POST {{Middleware_HostAddress}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "refresh_token_demo"
}

### Auth logout
POST {{Middleware_HostAddress}}/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "refresh_token_demo"
}

### Auth cambiar-password
POST {{Middleware_HostAddress}}/api/v1/auth/cambiar-password
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "passwordActual": "Demo123*",
  "passwordNuevo": "Demo456*"
}

### Alojamiento search
GET {{Middleware_HostAddress}}/api/v1/accommodations/search?Destino=Quito&Pagina=1&Limite=10

### Reserva integrada create
POST {{Middleware_HostAddress}}/api/v1/accommodations/reservas
Content-Type: application/json

{
  "cliente": {
    "tipoIdentificacion": "CED",
    "numeroIdentificacion": "0102030405",
    "nombres": "Cliente Demo",
    "apellidos": "Hotel",
    "correo": "cliente.demo@hoteljj.com",
    "telefono": "0999999999",
    "direccion": "Direccion demo"
  },
  "sucursalGuid": "11111111-1111-1111-1111-111111111111",
  "fechaInicio": "2026-06-10",
  "fechaFin": "2026-06-12",
  "habitaciones": [
    {
      "habitacionGuid": "22222222-2222-2222-2222-222222222222",
      "fechaInicio": "2026-06-10",
      "fechaFin": "2026-06-12",
      "numAdultos": 2,
      "numNinos": 0
    }
  ]
}

### Check-in
POST {{Middleware_HostAddress}}/api/v1/internal/hospedaje/check-in/{{reservaGuid}}
Authorization: Bearer {{jwt}}

### Crear cargo
POST {{Middleware_HostAddress}}/api/v1/internal/hospedaje/{{estadiaGuid}}/cargos
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "descripcionCargo": "Consumo minibar",
  "cantidad": 1,
  "precioUnitario": 8.50
}

### Check-out
PATCH {{Middleware_HostAddress}}/api/v1/internal/hospedaje/{{estadiaGuid}}/check-out
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "observaciones": "Salida normal",
  "requiereMantenimiento": false
}

### Generar factura final
POST {{Middleware_HostAddress}}/api/v1/internal/facturas/generar-final/{{reservaGuid}}
Authorization: Bearer {{jwt}}

### Consultar saldo factura
GET {{Middleware_HostAddress}}/api/v1/internal/facturas/{{facturaGuid}}/saldo
Authorization: Bearer {{jwt}}
